{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "josahcriativos.vercel.app"
        }
      ],
      "destination": "https://josahcriativos.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/trabalhos/festival-de-roteiro",
      "destination": "/trabalhos/fera",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "framework": "astro"
}